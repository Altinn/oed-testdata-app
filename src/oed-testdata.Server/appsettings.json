{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // The Application Insights logger provider installs its own filter defaulting to
    // Warning, and a provider-specific rule beats the global LogLevel above. Without this
    // section every LogInformation is dropped before it leaves the process, which is why
    // oed-testapp-ai recorded 20 traces in 30 days, all of them Warning. Framework
    // categories stay at Warning so the app logs are not buried in request plumbing.
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AltinnSettings": {
    "TokenGeneratorUrl": "",
    "PlatformUrl": "",
    "Username": "",
    "Password": ""
  },
  "AuthSettings": {
    "Username": "",
    "Password": "",
    "CloudEventQueryParamName": "",
    "CloudEventSecret": ""
  },
  "OedEventsSettings": {
    "BaseAddress": ""
  },
  "MaskinportenSettings": {
    "ClientId": "",
    "EncodedJwk": "",
    "Environment": "",
    "TokenExchangeEnvironment": ""
  },
  "AllowedHosts": "*"
}
